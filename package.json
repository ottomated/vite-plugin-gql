{
	"name": "@o7/vite-plugin-gql",
	"version": "0.3.1",
	"description": "Lightest-weight type-safe GraphQL queries",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"keywords": [
		"vite-plugin",
		"graphql",
		"gql",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ottomated/vite-plugin-gql.git"
	},
	"bin": {
		"gql-typegen": "./dist/bin.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "eslint --cache .",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --cache --write .",
		"release": "bumpp && pnpm publish",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"@types/estree": "^1.0.9",
		"@types/node": "^25.9.0",
		"bumpp": "^11.1.0",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"rolldown": "^1.0.1",
		"tsdown": "0.22.0",
		"tsx": "^4.22.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13"
	},
	"packageManager": "pnpm@11.1.3",
	"dependencies": {
		"@graphql-tools/load": "^8.1.10",
		"@graphql-tools/url-loader": "^9.1.2",
		"@rolldown/pluginutils": "^1.0.1",
		"chokidar": "^5.0.0",
		"fdir": "^6.5.0",
		"graphql": "^16.14.0",
		"magic-string": "^0.30.21",
		"oxc-parser": "^0.132.0",
		"prettier": "^3.8.3",
		"zimmerframe": "^1.1.4"
	}
}
